PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=trycatch_db

# Admin panel (usuario inicial que se siembra en la tabla users)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
# Secreto para firmar la cookie de sesión — genera uno con: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-cambia-esto

# Contacto (se muestran en el footer)
CONTACT_EMAIL=contacto@trycatchgt.org
# WhatsApp en formato internacional, solo dígitos (ej. 50255555555)
WHATSAPP_NUMBER=50200000000
WHATSAPP_MESSAGE=Hola TryCatch GT, vengo desde su sitio web.
