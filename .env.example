# Copia este archivo a .env y completa los valores. .env NO se commitea.
# Genera los secretos con:  openssl rand -hex 32

PORT=3000
NODE_ENV=development

# URL pública base del sitio. Se usa para construir los enlaces de los correos
# (verificación de correo, recuperación de contraseña). En producción DEBE ser la
# URL real con https, o los enlaces apuntarán a http://localhost y no servirán.
APP_URL=http://localhost:3000

# Ruta del panel de administración. Por defecto /admin. Puedes moverlo a una ruta
# secreta para que no sea trivial de encontrar (ofuscación que complementa la auth,
# no la reemplaza). Si la cambias, /admin deja de responder. Ej: ADMIN_PATH=/gestion-x7k2
ADMIN_PATH=/admin

# ── Base de datos (app) ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=trycatch
DB_PASSWORD=cambia-esta-clave-de-bd
DB_NAME=trycatch_db

# ── Docker: MySQL del docker-compose ─────────────────────────────────
# Solo se usan al levantar con `docker compose`. En el stack local, la app se
# conecta como DB_USER/DB_PASSWORD (usuario limitado a trycatch_db), no como root.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_USER=trycatch
MYSQL_PASSWORD=cambia-esta-clave-de-bd

# ── Seguridad ────────────────────────────────────────────────────────
# Firma de la cookie de sesión (HMAC). Genera uno con: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-cambia-esto
# Cifrado de los secretos MFA (AES-256), independiente de SESSION_SECRET para
# poder rotar la sesión sin perder el 2FA. Genera otro: openssl rand -hex 32
ENCRYPTION_KEY=dev-encryption-key-cambia-esto

# ── Admin inicial (se siembra si la tabla users está vacía) ──────────
ADMIN_USER=admin
# Mínimo 12 caracteres; evita valores obvios (password, admin12345, el usuario…)
ADMIN_PASSWORD=cambia-esta-clave-larga

# ── Contacto (se muestran en el footer) ──────────────────────────────
CONTACT_EMAIL=contacto@trycatchgt.org
# WhatsApp en formato internacional, solo dígitos (ej. 50255555555)
WHATSAPP_NUMBER=50200000000
WHATSAPP_MESSAGE=Hola TryCatch GT, vengo desde su sitio web.
